  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Mercenary's Ledger
  body: 'Paid in full: one Knight-Captain, Sir Aldric.

    Paid in full: the old
    king''s guard, all eleven.


    Owed: the Master''s share. He keeps the contract
    on him, says it''s his insurance.'
  verb: Read
  unreadMarker: {fileID: 486733840}
