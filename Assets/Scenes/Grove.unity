  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Hermit's Map (copy)
  body: 'The pass through the Frozen Taiga is guarded, but there is a hidden path
    past the smiths'' forge.

    From there the castle''s postern gate lies open
    to anyone bold enough.'
  verb: Read
  unreadMarker: {fileID: 1890906861}
