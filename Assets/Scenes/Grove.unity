  m_Script: {fileID: 11500000, guid: 62047982f4d858343856b4174ffbd9e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Hermit's Journal
  body: 'Day forty. Brother Oswin walked out of the bog this morning. We buried him
    a month ago.


    The colossus in the clearing was the king''s own executioner.
    Malvric''s mages made it something else.'
  verb: Read
  unreadMarker: {fileID: 1002095253}
