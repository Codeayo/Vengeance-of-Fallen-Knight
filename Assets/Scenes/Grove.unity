  m_Script: {fileID: 11500000, guid: 62047982f4d858343856b4174ffbd9e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Hermit's Warning
  body: 'Turn back, traveller. Since the usurper''s mages came, the dead do not stay
    in the earth here.


    If you must pass, keep to the high caps of the great
    mushrooms. The rot sleeps below.'
  verb: Read
  unreadMarker: {fileID: 507852013}
