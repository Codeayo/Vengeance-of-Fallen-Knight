  m_Script: {fileID: 11500000, guid: 62047982f4d858343856b4174ffbd9e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Smith's Letter
  body: 'We forged for the old king and we will not forge for a usurper. The frost
    watch can starve us if they like.


    Our last blade, Frostbrand, we gave to
    the Warden to keep it from Malvric. Now the Warden serves him.'
  verb: Read
  unreadMarker: {fileID: 1321549465}
