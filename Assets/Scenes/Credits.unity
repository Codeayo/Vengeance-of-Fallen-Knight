  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=170%><color=#E8C27A><b>VENGEANCE</b></color></size>\n<size=110%>OF
    THE FALLEN KNIGHT</size>\n\n\n<i>Lord Malvric lies dead at the foot of the throne
    he stole.\nThe eleven of the old guard are avenged, and the truth of the night\nSir
    Aldric fell is carried to every corner of the realm.\n\nThe Shard of the Crown
    is returned to the old king's line.\nThe fallen knight lays down his sword before
    the empty throne\nand, at last, is allowed to rest.</i>\n\n\n<size=130%><color=#E8C27A><b>A
    GAME BY</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014  \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Created,
    designed and directed by</color></size>\n<b>Codeayo</b>\n\n\n\n<size=130%><color=#E8C27A><b>DRAMATIS
    PERSONAE</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014  \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>The
    Fallen Knight</color></size>\n<b>Sir Aldric, Knight-Captain of the Order</b>\n\n<size=78%><color=#A9A3AA>The
    Narrator</color></size>\n<b>The Watcher</b>\n\n<size=78%><color=#A9A3AA>The Usurper
    King</color></size>\n<b>Lord Malvric</b>\n\n<size=78%><color=#A9A3AA>Malvric's
    Blade</color></size>\n<b>Kage</b>\n\n<size=78%><color=#A9A3AA>Captain of the
    Black Guard</color></size>\n<b>Sir Dravek</b>\n\n<size=78%><color=#A9A3AA>Keeper
    of the Crypts</color></size>\n<b>The Gravewarden</b>\n\n<size=78%><color=#A9A3AA>The
    King's Executioner, Unmade</color></size>\n<b>The Rotting Colossus</b>\n\n<size=78%><color=#A9A3AA>Guardian
    of Frostbrand</color></size>\n<b>The Frost Warden</b>\n\n\n\n<size=130%><color=#E8C27A><b>ART
    & ASSET CREDITS</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014  \u2022 
    \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Main Character</color></size>\n<b>SpellSoft
    Pixel</b>\n<size=70%><color=#A9A3AA>spellsoftpixel.itch.io/2d-soulslike-knight</color></size>\n\n<size=78%><color=#A9A3AA>Heart
    UI</color></size>\n<b>In The Void</b>\n<size=70%><color=#A9A3AA>in-the-void.itch.io/pixel-hearts-pack</color></size>\n\n<size=78%><color=#A9A3AA>Main
    Menu & GUI</color></size>\n<b>Tiopalada</b>\n<size=70%><color=#A9A3AA>tiopalada.itch.io/tiny-rpg-mana-soul-gui</color></size>\n\n<size=78%><color=#A9A3AA>Collectible
    Items</color></size>\n<b>Dani Maccari</b>\n<size=70%><color=#A9A3AA>dani-maccari.itch.io/platformer-metroidvania-pixel-items-free-assets</color></size>\n\n\n\n<size=130%><color=#E8C27A><b>ENEMIES</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014 
    \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Skeleton Enemy
    Pack</color></size>\n<b>Jesse M</b>\n<size=70%><color=#A9A3AA>jesse-m.itch.io/skeleton-pack</color></size>\n\n<size=78%><color=#A9A3AA>Ninja
    Enemy Pack</color></size>\n<b>KBPixelArt</b>\n<size=70%><color=#A9A3AA>kbpixelart.itch.io/ninja-enemy-pack</color></size>\n\n<size=78%><color=#A9A3AA>Skeleton
    Warrior</color></size>\n<b>Skeleton Warrior sprite set</b>\n\n\n\n<size=130%><color=#E8C27A><b>ENVIRONMENT
    ART</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014  \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Moon
    Graveyard  \u2022  Hero's Journey: Wood Camp  \u2022  Mushroom Grove\nFinal Taiga
    Forest  \u2022  Castle Hall  \u2022  Dungeon Prison</color></size>\n<b>Anokolisa</b>\n<size=70%><color=#A9A3AA>anokolisa.itch.io</color></size>\n\n<size=78%><color=#A9A3AA>Fantasy
    Swamp Forest</color></size>\n<b>The Flavare</b>\n<size=70%><color=#A9A3AA>theflavare.itch.io</color></size>\n\n\n\n<size=130%><color=#E8C27A><b>EFFECTS
    AND TYPE</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014  \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Explosions
    Pack</color></size>\n<b>Luis Zuno (Ansimuz)</b>\n<size=70%><color=#A9A3AA>ansimuz.itch.io</color></size>\n\n<size=78%><color=#A9A3AA>Typeface</color></size>\n<b>Liberation
    Sans</b>\n<size=70%><color=#A9A3AA>Red Hat  \u2022  SIL Open Font License</color></size>\n\n\n\n<size=130%><color=#E8C27A><b>AUDIO</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014 
    \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Bonfires Dungeon
    Pack</color></size>\n<b>Arnocyreus</b>\n<size=70%><color=#A9A3AA>arnocyreus.itch.io/bonfiresdungeon</color></size>\n\n<size=78%><color=#A9A3AA>Nightfall 
    \u2022  Mistridden Woods  \u2022  Voices From The Grove  \u2022  Ruins In The
    Deep\nNecron's Tower  \u2022  Temple Of Illas  \u2022  Cursemark  \u2022  Tyrant's
    Lament  \u2022  Bonfires</color></size>\n\n\n\n<size=130%><color=#E8C27A><b>SOUND</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014 
    \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Sound effects
    and ambience</color></size>\n<b>Synthesized for this game</b>\n\n\n\n<size=130%><color=#E8C27A><b>TECHNOLOGY</b></color></size>\n<color=#E8C27A>\u2014\u2014\u2014 
    \u2022  \u2014\u2014\u2014</color>\n\n<size=78%><color=#A9A3AA>Engine</color></size>\n<b>Unity
    6</b>\n\n<size=78%><color=#A9A3AA>Rendering and tools</color></size>\n<b>Universal
    Render Pipeline 2D  \u2022  Cinemachine  \u2022  TextMesh Pro  \u2022  Input
    System</b>\n\n<size=78%><color=#A9A3AA>Development assistance</color></size>\n<b>Claude
    Code by Anthropic</b>\n\n\n\n\n<color=#A9A3AA><size=80%>All third-party assets
    are used under the licenses provided by their creators.\nThank you to every artist
    and musician who shared their work.</size></color>"
