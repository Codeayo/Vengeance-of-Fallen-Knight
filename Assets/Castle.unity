  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  range: 2.2
  title: Steward's Ledger
  body: 'By order of King Malvric, the old guard''s names are struck from the rolls.


    The
    vault key hangs in the high gallery above the barracks. The old king''s sword
    lies within. None may touch it.'
  verb: Read
  unreadMarker: {fileID: 1278838336}
